# Include your project-specific ignores in this file
# Read about how to use .gitignore: https://help.github.com/articles/ignoring-files
# Useful .gitignore templates: https://github.com/github/gitignore

# Dependencies
node_modules/

# Build output
dist/
build/

# Webpack cache
.cache/

# Tailwind / PostCSS cache
.tailwindcss-cache/

# Generated CSS (built from input.css)
css/style.css

# IDE – JetBrains
.idea/
*.iml

# IDE – VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Environment variables
.env
.env.local
.env.*.local

# Optional: lock files (remove these lines if you want to commit them)
# package-lock.json
# yarn.lock
