{
  "name": "krise-und-kreativitaet",
  "version": "0.1.0",
  "description": "Krise & Kreativität",
  "private": true,
  "scripts": {
    "ng": "ng",
    "tailwind": "tailwindcss -i css/input.css -o src/styles.css",
    "tailwind:watch": "tailwindcss -i css/input.css -o src/styles.css --watch",
    "start": "concurrently \"npm run tailwind:watch\" \"ng serve\"",
    "build": "npm run tailwind && ng build",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@tailwindcss/postcss": "^4.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.0"
  }
}
