{
  "name": "projekt-funken",
  "version": "0.1.0",
  "description": "Projekt Funken",
  "private": true,
  "keywords": [
    "schreiben",
    "kreativtherapie",
    "schreibprojekt",
    "jane-spiekermann"
  ],
  "license": "UNLICENSED",
  "author": "joscco",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "css:dev":   "tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "css:build": "tailwindcss -i ./css/input.css -o ./css/style.css --minify",
    "start": "concurrently \"npm run css:dev\" \"webpack serve --config webpack.config.dev.js\"",
    "build": "npm run css:build && webpack --config webpack.config.prod.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-plugin": "^5.6.0",
    "tailwindcss": "^4.2.4",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-merge": "^5.10.0"
  }
}
